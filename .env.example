# Copy to .env for local simulated development. Do not commit .env.
HOST=127.0.0.1
PORT=3100

# A real receiver requires an explicit provider, payment environment and network.
# NWC signet example (set a receive-only connection secret in the private .env):
# LIGHTNING_PROVIDER=nwc
# PAYMENT_ENVIRONMENT=signet
# LNBITS_NETWORK=signet
# NWC_RECEIVER_CONNECTION_SECRET=nostr+walletconnect://...
# For a private Mutinynet run, copy these settings to ignored .env.mutinynet,
# set DATA_DIR=data/mutinynet and PORT=3102, then use npm run start:mutinynet.
# Keep the separate payer connection only in ignored .env.mutinynet-payer.

# Alternative LNbits signet receiver. Use its invoice/read key, never its admin key:
# LIGHTNING_PROVIDER=lnbits
# PAYMENT_ENVIRONMENT=signet
# LNBITS_NETWORK=signet
# LNBITS_URL=https://your-lnbits.example
# LNBITS_INVOICE_KEY=...

# Alby Developer Sandbox is fake sats. Use npm run configure:sandbox to generate
# the ignored .env.sandbox; its NWC API reports mainnet despite fake balances.
# The sandbox additionally requires a distinct payer wallet public key.

# Guest demos get private Alby sandbox wallets (test sats, real NWC invoices)
# from https://faucet.nwc.dev, falling back to simulation if it is unreachable.
# Set to 0 to keep guest demos fully simulated with no outbound faucet calls.
# GUEST_LIGHTNING_SANDBOX=0

# Vercel /api/practice functions (and npm run preview:vercel): real Mutinynet
# practice payments (test coins). Preferred: an always-online hosted LND node on
# Mutinynet (e.g. Voltage) with its INVOICE macaroon in hex. A macaroon that can
# pay, send coins or manage the node is refused. Keep the macaroon private.
# LND_REST_URL=https://your-node.example:8080
# LND_INVOICE_MACAROON=
# Otherwise the treasurer's receive-only NWC connection above is used with
# PAYMENT_ENVIRONMENT=signet and LNBITS_NETWORK=signet. Set to 0 to disable.
# PRACTICE_LIGHTNING=0

# Optional real-sat practice invoices (mainnet) on the public demo: a Blink API
# key with ONLY the Read and Receive scopes (a Write key is refused).
# BLINK_RECEIVE_API_KEY=
# PRACTICE_MAINNET=0

# Production only: a single Node process behind an HTTPS reverse proxy, with a
# persistent directory outside this source tree. Set all three explicitly.
# NODE_ENV=production
# PUBLIC_HTTPS=1
# TRUST_PROXY=1
# DATA_DIR=/var/lib/circlesats

# Keep TLS certificate validation enabled. If your host uses the OS trust store,
# NODE_OPTIONS=--use-system-ca may be set without disabling verification.
